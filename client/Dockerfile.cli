# ── Stage 1: build Vite frontend ─────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /build

# Install deps (skip electron binary download — not needed for vite build)
COPY package*.json ./
RUN npm ci --ignore-scripts

# Copy only the frontend source needed for vite build
COPY index.html vite.config.js tailwind.config.js postcss.config.js ./
COPY shared ./shared
COPY src ./src

RUN npx vite build

# ── Stage 2: native deps（better-sqlite3：优先预编译，否则 node-gyp 编译）────────
# 固定 Node 22.21 LTS：pi 等命令行智能体要求 Node ≥ 22.19；better-sqlite3 按 Node ABI 提供预编译包（22.x 同一 ABI）；
# slim 需补 python3/g++ 作编译回退
FROM node:22.21-bookworm-slim AS native-deps
WORKDIR /deps
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ libsqlite3-dev \
  && npm config set fetch-retries 5 \
  && npm config set fetch-retry-mintimeout 20000 \
  && npm install --omit=dev js-yaml@4.1.1 better-sqlite3@12.10.0 ws@8.20.0 https-proxy-agent@7.0.6 proxy-from-env@2.1.0 fzstd@0.1.1 adm-zip@0.6.0 \
  && rm -rf /var/lib/apt/lists/*

# ── Stage 3: runtime（与 native-deps 同 Node 版本）────────────────────────────
FROM node:22.21-bookworm-slim
WORKDIR /app

# CLI entry + shared helpers + 构建脚本（剪枝后删除 scripts）
COPY package.json ./package.json
COPY cli     ./cli
COPY shared  ./shared
COPY scripts ./scripts

# 与桌面版共用完整 electron 模块，仅剪枝 Electron 壳专属文件（见 scripts/cli-runtime-manifest.js）
COPY electron ./electron
RUN node scripts/prune-electron-for-cli.js && rm -rf ./scripts

# 运行时 npm 依赖（来自 native-deps 阶段，无需 node-gyp 编译）
COPY --from=native-deps /deps/node_modules ./node_modules

# Pre-built Web UI (served by admin-api on :11431)
COPY --from=builder /build/dist ./dist

# Gateway :11430  |  Admin UI / API :11431
EXPOSE 11430 11431

# Config lives in /data — mount a volume or bind-mount your config directory here
ENV HOME=/data
# Override the default ~/.llm-agent path used by config-loader.js
ENV LLM_AGENT_CONFIG_DIR=/data/.llm-agent
# 默认 Token Bank 服务地址（未在 local-config.json 配置 cloud_config.url 时使用）
# ENV TOKEN_SERVER_URL=https://your-token-server.example.com

# 命令行智能体（Claude Code、pi、Codex…）装在 /data 下：普通用户可写，升级镜像后仍在
ENV NPM_CONFIG_PREFIX=/data/.npm-global
ENV PATH=/data/.npm-global/bin:$PATH
# 智能体默认工作目录：把项目目录挂到 /workspace
ENV TOKENBANK_WORKDIR=/workspace
# 运行用户（镜像自带的 node 用户）；绑定宿主机目录时可设为宿主机用户的 uid/gid
ENV TOKENBANK_UID=1000
ENV TOKENBANK_GID=1000
RUN mkdir -p /workspace

# 以 root 启动只做准备（修正 /data 属主），随后降为 TOKENBANK_UID 运行，见 cli/docker-entry.js
ENTRYPOINT ["node", "cli/docker-entry.js"]
CMD ["start"]
