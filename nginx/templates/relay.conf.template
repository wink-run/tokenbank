# 可选：设备网络中继（需同时启用 compose profile mesh，并放好 relay-fullchain.pem / relay-privkey.pem）
# 环境变量：RELAY_DOMAIN、RELAY_UPSTREAM（默认 mesh-relay:3340）
# 服务端环境变量 MESH_RELAY_URLS 写 https://<RELAY_DOMAIN>/，设备领证书时一起拿到

map $http_upgrade $relay_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${RELAY_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${RELAY_DOMAIN};

    ssl_certificate     /etc/nginx/certs/relay-fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/relay-privkey.pem;
    ssl_session_timeout 1d;
    ssl_protocols TLSv1.2 TLSv1.3;

    # 中继走 WebSocket 升级（HTTP/1.1），连接很长
    location / {
        proxy_pass http://${RELAY_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $relay_connection_upgrade;
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_connect_timeout 60s;
        proxy_send_timeout    1d;
        proxy_read_timeout    1d;
    }
}
